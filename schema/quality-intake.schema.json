{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "af-dashboard/quality-intake.schema.json",
  "title": "Quality intake history",
  "description": "Sprint-window intake aggregates and the ticket detail used only on the Quality Intake page.",
  "type": "object",
  "required": ["refreshedAt", "exportedAt", "source", "sprints"],
  "additionalProperties": false,
  "properties": {
    "refreshedAt": { "type": "string", "format": "date" },
    "exportedAt": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "sprints": {
      "type": "array",
      "items": { "$ref": "#/$defs/sprint" }
    }
  },
  "$defs": {
    "sprint": {
      "type": "object",
      "required": ["sprintId", "name", "windowStart", "windowEnd", "weekdays", "partial", "counts", "ratesPer10Weekdays", "tickets"],
      "additionalProperties": false,
      "properties": {
        "sprintId": { "type": "integer", "minimum": 1 },
        "name": { "type": ["string", "null"] },
        "windowStart": { "type": ["string", "null"], "format": "date" },
        "windowEnd": { "type": ["string", "null"], "format": "date" },
        "weekdays": { "type": ["integer", "null"], "minimum": 0 },
        "partial": { "type": ["boolean", "null"] },
        "counts": {
          "type": "object",
          "required": ["pswat", "appBugs"],
          "additionalProperties": false,
          "properties": {
            "pswat": { "type": ["integer", "null"], "minimum": 0 },
            "appBugs": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "ratesPer10Weekdays": {
          "type": "object",
          "required": ["pswat", "appBugs"],
          "additionalProperties": false,
          "properties": {
            "pswat": { "type": ["number", "null"], "minimum": 0 },
            "appBugs": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "tickets": {
          "type": "array",
          "items": { "$ref": "#/$defs/ticket" }
        }
      }
    },
    "ticket": {
      "type": "object",
      "required": ["source", "key", "summary", "type", "status", "created", "url"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "enum": ["PSWAT", "APP Bugs"] },
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$" },
        "summary": { "type": ["string", "null"] },
        "type": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "created": { "type": ["string", "null"], "format": "date" },
        "url": { "type": ["string", "null"], "pattern": "^https://mysnaplogic\\.atlassian\\.net/browse/[A-Z][A-Z0-9]+-[0-9]+$" }
      }
    }
  }
}
