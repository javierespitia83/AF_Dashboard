{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio-projects.schema.json",
  "title": "Portfolio projects manifest",
  "description": "Allowlist of portfolio projects. Each entry points to a per-team JSON file. Only keys listed here may be loaded.",
  "type": "object",
  "required": ["refreshedAt", "projects"],
  "additionalProperties": false,
  "properties": {
    "refreshedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "exportedAt": { "type": "string" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "currentSprintId", "file"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+$" },
          "label": { "type": "string" },
          "currentSprintId": { "type": "integer" },
          "file": { "type": "string", "pattern": "^portfolio/[A-Z][A-Z0-9]+\\.json$" }
        }
      }
    }
  }
}
