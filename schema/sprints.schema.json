{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://af-dashboard.local/schema/sprints.schema.json",
  "title": "AF Dashboard sprint manifest",
  "description": "Allowlist of current and closed sprint snapshots available to the sprint page. Producers must match this schema exactly; the app itself ignores unknown keys (D74) so a new field cannot take the page down.",
  "type": "object",
  "required": [
    "current",
    "sprints"
  ],
  "additionalProperties": false,
  "properties": {
    "current": {
      "type": "integer",
      "minimum": 1
    },
    "sprints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sprint"
      },
      "contains": {
        "properties": {
          "state": {
            "const": "active"
          }
        },
        "required": [
          "state"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "$defs": {
    "sprint": {
      "type": "object",
      "required": [
        "id",
        "name",
        "startDate",
        "endDate",
        "state",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "state": {
          "enum": [
            "active",
            "closed"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^snapshots/sprint-[0-9]+\\.json$",
          "description": "Relative path of the sprint's snapshot. Must be snapshots/sprint-<id>.json; the app refuses any other path (DECISIONS D74)."
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
